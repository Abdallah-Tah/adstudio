# AI Ad Studio — environment variables. Copy to .env (git-ignored) and fill in.

# Postgres connection string (docker-compose default shown)
DATABASE_URL=postgresql+psycopg://adstudio:adstudio@localhost:5433/adstudio

# Redis broker/result backend for Celery
REDIS_URL=redis://localhost:6379/0

# Object storage — MinIO locally, R2/S3 in production
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ad-studio
S3_KEY=adstudio
S3_SECRET=adstudio-secret

# OpenAI — stages 1-4 structured-output calls + image generation (Phase 1/2)
OPENAI_API_KEY=

# Anthropic — QC vision verdicts (Phase 3)
ANTHROPIC_API_KEY=

# ElevenLabs — voiceover (Phase 3)
ELEVENLABS_API_KEY=

# Video engine (Gate 2 decision): Kling v3 Standard via fal.ai, audio off (Phase 3)
FAL_KEY=

# Commercially-licensed music source chosen at STOP GATE 2 (Phase 3)
MUSIC_LIBRARY_KEY=
