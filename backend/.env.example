# AI Ad Studio — environment variables. Copy to .env (git-ignored) and fill in.

# Postgres connection string (docker-compose default shown)
DATABASE_URL=postgresql+psycopg://adstudio:adstudio@localhost:5433/adstudio

# Redis broker/result backend for Celery
REDIS_URL=redis://localhost:6379/0

# Object storage — MinIO locally, R2/S3 in production
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ad-studio
S3_KEY=adstudio
S3_SECRET=adstudio-secret

# OpenAI — stages 1-4 structured-output calls + image generation (Phase 1/2)
OPENAI_API_KEY=

# Anthropic — QC vision verdicts (Phase 3)
ANTHROPIC_API_KEY=

# ElevenLabs — voiceover (Phase 3)
ELEVENLABS_API_KEY=

# Video generation via fal.ai (Phase 3). One key serves both engines.
FAL_KEY=
# Which fal video engine to use: "kling" (Gate 2 default, $0.084/s) or
# "ltx" (LTX-Video 13B 0.9.8 distilled, $0.02/s). Defaults to kling.
VIDEO_ENGINE=kling

# Cross-scene product identity gate: judges all selected scene images together
# against the primary product reference before any video spend. Uses
# OPENAI_API_KEY. Set to false to disable (not recommended).
SCENE_CONSISTENCY_QC_ENABLED=true

# Auth: set to true to mark the session cookie Secure (HTTPS-only). Leave unset
# for plain-HTTP local dev; safe to enable behind the Cloudflare (HTTPS) tunnel.
COOKIE_SECURE=

# Commercially-licensed music source chosen at STOP GATE 2 (Phase 3)
MUSIC_LIBRARY_KEY=
